# Web bundle + secrets
web/node_modules/
web/app.js
web/app.js.map
web/.env
web/package-lock.json

# Native build scratch
*.o
*.d
backends/emscripten-raycast/obj/
backends/emscripten-opengl/obj/
backends/rust/target/
