# Copy to .env and fill in your values:
#   cp .env.example .env
#
# SENTRY_DSN — used by `npm run build:js` (injected into app.js)
SENTRY_DSN=

# sentry CLI (getsentry/cli) — debug wasm + JS source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Local getsentry/cli repo (default: code/cli/cli next to demo/)
# SENTRY_CLI_ROOT=/Users/you/code/cli/cli

# Must match between `npm run build:js`, Sentry.init release, and sourcemap upload
SENTRY_RELEASE=wasm-maze-demo@dev

# Stack abs_path prefix for JS sourcemap upload (change if not using port 8080)
SENTRY_URL_PREFIX=http://localhost:8080/web/
